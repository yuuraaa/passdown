{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "allowJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.server.tsbuildinfo"
  },
  "include": [
    "src/server/**/*.ts",
    "src/cli/**/*.ts",
    "vite.config.ts",
    "drizzle.config.ts",
    "eslint.config.js"
  ]
}
