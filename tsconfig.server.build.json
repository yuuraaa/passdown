{
  "extends": "./tsconfig.server.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist/server",
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.server.build.tsbuildinfo"
  },
  "include": ["src/server/**/*.ts", "src/cli/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/server/testing/**"]
}
