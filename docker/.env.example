# 実際に MCP クライアントが接続するホスト名または IP アドレスに置き換える
PASSDOWN_MCP_ALLOWED_HOSTS=localhost,passdown.example.internal

# 以下は省略すると記載の既定値になる。変更する項目だけコメントを外す。
# ホスト側の公開ポート。コンテナ内の待ち受けは常に 0.0.0.0:3000
# PASSDOWN_PORT=3000

# 復元時だけ restore_wait に切り替える。通常は server
# PASSDOWN_START_MODE=server

# named volume のコンテナ内マウント先。変更時はイメージを再ビルドする
# PASSDOWN_DATA_DIR=/data

# DB とバックアップの保存先。省略時はマウント先の中になる
# 個別に変更する場合も PASSDOWN_DATA_DIR の中を指定する
# PASSDOWN_DB_PATH=/data/passdown.sqlite3
# PASSDOWN_BACKUP_DIR=/data/backups

# バックアップの保持世代数
# PASSDOWN_BACKUP_KEEP_DAILY=14
# PASSDOWN_BACKUP_KEEP_MIGRATION=5

# 日次バックアップ間隔と、リクエスト時の確認間隔（ミリ秒）
# PASSDOWN_BACKUP_INTERVAL_MS=86400000
# PASSDOWN_CHECK_INTERVAL_MS=3600000

# PASSDOWN_HOST とコンテナ内の PASSDOWN_PORT は本番 Compose で固定する
